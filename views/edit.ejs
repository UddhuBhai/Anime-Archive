<%- include("partials/header") %>
<%- include("partials/navbar") %>

<section class="compose-page">

<div class="compose-card">

<p class="system">

SYSTEM

</p>

<h1>

Edit Episode

</h1>

<form action="/edit/<%= post.id %>" method="POST">

<div class="form-group">

<label>Episode Title</label>

<input
type="text"
name="title"
value="<%= post.title %>"
required>

</div>

<div class="form-group">

<label>Arc</label>

<input
type="text"
name="arc"
value="<%= post.arc %>"
required>

</div>

<div class="form-group">

<label>Synopsis</label>

<input
type="text"
name="synopsis"
value="<%= post.synopsis %>"
required>

</div>

<div class="form-group">

<label>Story</label>

<textarea
name="content"
rows="12"
required><%= post.content %></textarea>

</div>

<button class="publish-btn">

Save Changes

</button>

</form>

</div>

</section>

<%- include("partials/footer") %>